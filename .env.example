# ─────────────────────────────────────────────────────────────────────────────
# Auto-Twibbon Studio — Konfigurasi Environment
# Salin file ini menjadi .env dan isi sesuai kebutuhan.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage Backend ───────────────────────────────────────────────────────────
# Opsi Penyimpanan:
#   1. browser  -> (REKOMENDASI INSTAN) File HANYA disimpan di RAM sementara/browser.
#                  Super cepat, tanpa loading upload, file TIDAK disimpan ke disk/cloud.
#   2. local    -> Simpan file ke folder komputer lokal (LOCAL_STORAGE_PATH)
#   3. supabase -> Simpan file ke cloud Supabase Storage bucket (SUPABASE_URL & KEY)
#
STORAGE_TYPE=browser

# ── [local] Konfigurasi penyimpanan lokal ────────────────────────────────────
# Folder tempat file disimpan (relatif dari direktori app.py)
LOCAL_STORAGE_PATH=storage

# ── [supabase] Konfigurasi Supabase Storage ───────────────────────────────────
# Isi bagian ini HANYA jika STORAGE_TYPE=supabase
#
# 1. Buat project di https://supabase.com
# 2. Masuk ke Storage → buat bucket baru (misal: twibbon-files)
# 3. Set bucket ke PUBLIC (agar URL gambar bisa diakses browser)
# 4. Salin URL dan API Key dari Settings → API
#
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=twibbon-files

# ── Flask ─────────────────────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman di production!
SECRET_KEY=ganti-dengan-secret-key-yang-aman

# Port server (default 8000)
PORT=8000

# Mode debug — set ke false di production
FLASK_DEBUG=true
